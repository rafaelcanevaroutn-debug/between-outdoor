{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoResponse",
  "description": "Contrato de respuesta para videos (Reels / TikTok)",
  "type": "object",
  "required": ["formato", "tema", "vertical", "titulo", "subtitulo", "bullets", "cta"],
  "properties": {
    "formato": { "type": "string", "enum": ["video"] },
    "tema": { "type": "string" },
    "vertical": { "type": "string" },
    "titulo": { "type": "string", "maxLength": 100 },
    "subtitulo": { "type": "string", "maxLength": 250 },
    "bullets": { "type": "array", "items": { "type": "string" } },
    "cta": { "type": "string" },
    "audio_sugerido": { "type": "string" },
    "texto_en_pantalla": { "type": "array", "items": { "type": "string" } }
  }
}
